rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // User profile document
    match /users/{userId} {
      allow get, write: if isOwner(userId);

      // User's private chat sessions
      match /chats/{chatId} {
        allow get, delete: if isOwner(userId) && isValidId(chatId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(chatId)
          && request.resource.data.userId == userId;
        allow update: if isOwner(userId) && isValidId(chatId)
          && request.resource.data.userId == userId;

        // Messages within a chat session
        match /messages/{messageId} {
          allow get, delete: if isOwner(userId) && isValidId(chatId) && isValidId(messageId);
          allow list: if isOwner(userId) && isValidId(chatId);
          allow create: if isOwner(userId) && isValidId(chatId) && isValidId(messageId)
            && request.resource.data.userId == userId;
          allow update: if isOwner(userId) && isValidId(chatId) && isValidId(messageId)
            && request.resource.data.userId == userId;
        }
      }
    }
  }
}
